# ==================== QwenPaw 环境变量配置 ====================
# 复制此文件为 .env 并填入实际值

# ==================== QwenPaw 基础配置 ====================
# 工作目录（固定为 /data/qwenpaw 不可修改）
# QWENPAW_WORKING_DIR=/data/qwenpaw

# 配置文件名（默认：config.json）
# QWENPAW_CONFIG_FILE=config.json

# 日志级别：debug, info, warning, error, critical（默认：info）
# QWENPAW_LOG_LEVEL=info

# 监听端口（默认：8088）
# QWENPAW_PORT=8088

# 是否自动初始化（默认：true）
# QWENPAW_AUTO_INIT=true

# ==================== Web 认证配置 (v1.1.0+) ====================
# 是否启用 Web 认证（默认：false）
# 启用后首次访问会显示注册页面，本地请求 (127.0.0.1) 自动绕过认证
# QWENPAW_AUTH_ENABLED=false

# 自动注册管理员账户（可选，适用于自动化部署场景）
# 当启用认证且尚未注册用户时，可设置以下变量自动创建管理员账户
# 注意：仅在首次启动且无已注册用户时生效，之后会被忽略
# QWENPAW_AUTH_USERNAME=admin
# QWENPAW_AUTH_PASSWORD=your_secure_password_here

# ==================== 安全配置 ====================
# 是否启用工具守卫（默认：true）
# QWENPAW_TOOL_GUARD_ENABLED=true

# 工具守卫审批超时时间（秒，默认：600）
# QWENPAW_TOOL_GUARD_APPROVAL_TIMEOUT_SECONDS=600

# 技能扫描模式（默认：warn，可选：block / warn / off）
# QWENPAW_SKILL_SCAN_MODE=warn

# ==================== Embedding 服务配置 ====================
# Embedding API Key（用于记忆向量搜索）
# 注意：需同时设置以下三个变量才能启用向量搜索功能
# EMBEDDING_API_KEY=your_embedding_api_key_here

# Embedding 服务 URL（示例：DashScope）
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Embedding 模型名称（示例：text-embedding-v4）
# EMBEDDING_MODEL_NAME=text-embedding-v4

# 是否启用 BM25 全文检索（默认：true）
# FTS_ENABLED=true

# ==================== 记忆存储配置 ====================
# 记忆存储后端（默认：auto）
# 可选：auto（自动检测）、local（本地文件）、chroma、sqlite
# MEMORY_STORE_BACKEND=auto

# 压缩后保留的最近消息数（默认：3）
# QWENPAW_MEMORY_COMPACT_KEEP_RECENT=3

# 触发压缩的阈值比例，相对于上下文窗口大小（默认：0.7）
# QWENPAW_MEMORY_COMPACT_RATIO=0.7

# 是否禁用记忆管理器（设置为 false 可禁用，默认启用）
# ENABLE_MEMORY_MANAGER=

# ==================== LLM 重试与并发配置 ====================
# LLM API 调用失败时的自动重试设置（指数退避）

# 最大重试次数（默认：3）
# QWENPAW_LLM_MAX_RETRIES=3

# 基础退避时间（秒），实际退避 = base * 2^retry_count（默认：1.0）
# QWENPAW_LLM_BACKOFF_BASE=1.0

# 最大退避时间上限（秒，默认：10.0）
# QWENPAW_LLM_BACKOFF_CAP=10.0

# 最大并发 LLM 调用数（默认：10）
# QWENPAW_LLM_MAX_CONCURRENT=10

# 每分钟最大请求数 QPM（默认：600，0 = 无限制）
# QWENPAW_LLM_MAX_QPM=600

# ==================== 模型提供商配置 ====================
#
# 注意：模型提供商的 API Key 需通过以下方式配置（不支持环境变量传入）：
# 1. WebUI 控制台 → Settings → Models
# 2. CLI 命令：docker compose exec qwenpaw qwenpaw models config
#

# DashScope 基础 URL（默认：https://dashscope.aliyuncs.com/compatible-mode/v1）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Ollama 服务地址（默认：http://127.0.0.1:11434）
# OLLAMA_HOST=http://127.0.0.1:11434

# ==================== 技能扩展配置 ====================
# Tavily 搜索 API Key（用于网络搜索技能）
# TAVILY_API_KEY=your_tavily_api_key_here

# ==================== 渠道控制 ====================
# 启用的渠道（逗号分隔，为空则启用所有已配置渠道）
# QWENPAW_ENABLED_CHANNELS=

# 禁用的渠道（逗号分隔）
# QWENPAW_DISABLED_CHANNELS=

# ==================== 其他可选配置 ====================
# 跨域资源共享 (CORS) 配置
# QWENPAW_CORS_ORIGINS=http://localhost:3000,https://example.com

# 是否暴露 OpenAPI 文档（默认：false，仅开发使用）
# QWENPAW_OPENAPI_DOCS=false

# Chromium 可执行文件路径（MCP 浏览器自动化）
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# 时区设置（默认：Asia/Shanghai）
# TZ=Asia/Shanghai

# 代理设置（如果需要）
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
