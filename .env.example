# ==================== QwenPaw 环境变量配置 ====================
# 复制此文件为 .env 并填入实际值

# ==================== QwenPaw 基础配置 ====================
# 工作目录（固定为 /data/qwenpaw 不可修改）
# QWENPAW_WORKING_DIR=/data/qwenpaw

# 配置文件名（默认：config.json）
# QWENPAW_CONFIG_FILE=config.json

# 日志级别：debug, info, warning, error, critical（默认：INFO）
# QWENPAW_LOG_LEVEL=INFO

# 是否自动初始化（默认：true）
# QWENPAW_AUTO_INIT=true

# ==================== Web 认证配置 (v0.1.0 新增) ====================
# 是否启用 Web 认证（默认：false）
# 启用后首次访问会显示注册页面，本地请求 (127.0.0.1) 自动绕过认证
# QWENPAW_AUTH_ENABLED=false

# 自动注册管理员账户（可选，适用于自动化部署场景）
# 当启用认证且尚未注册用户时，可设置以下变量自动创建管理员账户
# 注意：仅在首次启动且无已注册用户时生效，之后会被忽略
# QWENPAW_AUTH_USERNAME=admin
# QWENPAW_AUTH_PASSWORD=your_secure_password_here

# ==================== Embedding 服务配置 ====================
# Embedding API Key（用于记忆向量搜索）
# 注意：需同时设置以下三个变量才能启用向量搜索功能
# EMBEDDING_API_KEY=your_embedding_api_key_here

# Embedding 服务 URL（示例：DashScope）
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Embedding 模型名称（示例：text-embedding-v4）
# EMBEDDING_MODEL_NAME=text-embedding-v4

# 向量维度（默认：1024）
# EMBEDDING_DIMENSIONS=1024

# 是否启用 BM25 全文检索（默认：true）
# FTS_ENABLED=true

# 是否启用 Embedding 缓存（默认：true）
# EMBEDDING_CACHE_ENABLED=true

# ==================== 记忆存储配置 ====================
# 记忆存储后端（默认：auto）
# 可选：auto（自动检测）、local（本地文件）、chroma、sqlite
# MEMORY_STORE_BACKEND=auto

# 记忆压缩配置
# 触发记忆压缩的字符阈值（默认：100000）
# QWENPAW_MEMORY_COMPACT_THRESHOLD=100000

# 压缩后保留的最近消息数（默认：3）
# QWENPAW_MEMORY_COMPACT_KEEP_RECENT=3

# 触发压缩的阈值比例，相对于上下文窗口大小（默认：0.7）
# QWENPAW_MEMORY_COMPACT_RATIO=0.7

# ==================== 模型提供商配置 ====================
#
# 注意：模型提供商的 API Key 建议通过以下方式配置：
# 1. WebUI 控制台 → Settings → Models
# 2. CLI 命令：docker compose exec qwenpaw qwenpaw models config
#
# 以下环境变量仅作为后备方案：

# Anthropic (v0.0.5 新增)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gemini (v0.0.6 新增)
# GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek (v0.1.0 新增)
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# MiniMax (v0.1.0 新增)
# MINIMAX_API_KEY=your_minimax_api_key_here

# Kimi (v0.1.0 新增)
# KIMI_API_KEY=your_kimi_api_key_here

# Zhipu / 智谱 (v1.0.1 新增)
# ZHIPU_API_KEY=your_zhipu_api_key_here

# SiliconFlow (v1.0.2 新增)
# SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# OpenRouter (v1.1.1 新增)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# DashScope (灵积) - 后备方案
# 当 providers.json 中没有配置 LLM 时使用
# DASHSCOPE_API_KEY=your_dashscope_api_key_here
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ==================== LLM 重试配置 (v0.0.7 新增) ====================
# LLM API 调用失败时的自动重试设置（指数退避）
# 最大重试次数（默认：3）
# QWENPAW_LLM_MAX_RETRIES=3

# 基础退避时间（秒），实际退避 = base * 2^retry_count（默认：1.0）
# QWENPAW_LLM_BACKOFF_BASE=1.0

# 最大退避时间上限（秒，默认：60.0）
# QWENPAW_LLM_BACKOFF_CAP=60.0

# ==================== 技能扩展配置 ====================
# Tavily 搜索 API Key（用于网络搜索技能）
# TAVILY_API_KEY=your_tavily_api_key_here

# ==================== MCP 配置 ====================
# MCP 服务器环境变量（按需配置）
# MCP 连接的外部服务可能需要特定的环境变量
# MCP_FS_PATH=/path/to/allowed/directory
# MCP_API_KEY=your_mcp_service_api_key

# ==================== 其他可选配置 ====================
# 跨域资源共享 (CORS) 配置
# QWENPAW_CORS_ORIGINS=http://localhost:3000,https://example.com

# 时区设置（默认：Asia/Shanghai）
# TZ=Asia/Shanghai

# 代理设置（如果需要）
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1
